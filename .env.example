# Copy to .env.local for local development. Use dedicated local values.
# Never copy production credentials or customer files into a preview checkout.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Leave empty for local testing; no Discord messages will be sent.
DISCORD_WEBHOOK=

# Keep blank for local work. Production already has dedicated values.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_FROM_EMAIL=
ORDER_REPLY_TO_EMAIL=
ORDER_WORKFLOW_TOKEN=
# Leave blank to use the checkout's data/order-workflow directory.
ORDER_WORKFLOW_DIR=

# Existing code defaults, shown explicitly for local testing.
START_FEE=50
FILL_FACTOR=0.25
PACKAGING_GRAMS=30
MIN_GRAMS_PER_FILE=5

# SQLite currently uses prisma/dev.db, as configured in prisma/schema.prisma.
# DATABASE_URL does not override that path in the current schema.
